    {
      "name": "02 - Lobby",
      "item": [
        {
          "name": "Host Update Roles (4 players => 7 roles)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/games/{{gameId}}/commands",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{hostPlayerId}}\",\n  \"secret\": \"{{hostSecret}}\",\n  \"lastKnownVersion\": {{lastVersion}},\n  \"command\": {\n    \"type\": \"UPDATE_ROLES\",\n    \"payload\": {\n      \"roles\": [\"werewolf\", \"seer\", \"robber\", \"drunk\", \"villager\", \"villager\", \"tanner\"]\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('lastVersion', json.appliedVersion.toString());"
                ]
              }
            }
          ]
        },
