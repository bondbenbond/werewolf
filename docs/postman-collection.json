{
  "info": {
    "name": "Werewolf API (Complete Flow)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "gameId", "value": "" },
    { "key": "hostPlayerId", "value": "" },
    { "key": "hostSecret", "value": "" },
    { "key": "player1Id", "value": "" },
    { "key": "player1Secret", "value": "" },
    { "key": "player2Id", "value": "" },
    { "key": "player2Secret", "value": "" },
    { "key": "player3Id", "value": "" },
    { "key": "player3Secret", "value": "" },
    { "key": "lastVersion", "value": "0" }
  ],
  "item": [
    {
      "name": "01 - Setup",
      "item": [
        {
          "name": "Create Game",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/games",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostName\": \"Host\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('gameId', json.gameId);",
                  "pm.collectionVariables.set('hostPlayerId', json.host.playerId);",
                  "pm.collectionVariables.set('hostSecret', json.host.secret);",
                  "pm.collectionVariables.set('lastVersion', json.version.toString());"
                ]
              }
            }
          ]
        },
        {
          "name": "Join Game (Player 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/games/{{gameId}}/join",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Player 1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('player1Id', json.playerId);",
                  "pm.collectionVariables.set('player1Secret', json.secret);",
                  "pm.collectionVariables.set('lastVersion', json.version.toString());"
                ]
              }
            }
          ]
        },
        {
          "name": "Join Game (Player 2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
